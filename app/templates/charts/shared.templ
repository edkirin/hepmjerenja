package charts

// ChartHelpers emits shared JavaScript utility functions used by all chart components.
// It must be rendered before any individual chart component init function is called.
templ ChartHelpers() {
	<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
	<style>
		.chart-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem; }
		.chart-header h2 { margin-bottom: 0; }
		.chart-header-right { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
		.chart-day-select { font-size: 0.85rem; padding: 0.25rem 0.6rem; border: 1px solid #ddd; border-radius: 4px; background: #fff; color: #333; cursor: pointer; max-width: 100%; }
		html.dark .chart-day-select { background: #0f3460; color: #e0e0e0; border-color: #2a4a7f; }
		.chart-export-btn { font-size: 0.78rem; padding: 0.25rem 0.6rem; background: #fff; color: #555; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; white-space: nowrap; }
		.chart-export-btn:hover { background: #f0f4f8; }
		html.dark .chart-export-btn { background: #1a3a5c; color: #cdd8e3; border-color: #2a4a7f; }
		html.dark .chart-export-btn:hover { background: #1e4570; }

		/* VT/NT legend */
		.vtnt-legend { display: flex; align-items: center; gap: 0.6rem; font-size: 0.78rem; color: #888; }
		html.dark .vtnt-legend { color: #6a8aaa; }
		.vtnt-legend-item { display: flex; align-items: center; gap: 0.3rem; white-space: nowrap; }
		.vtnt-legend-swatch { display: inline-block; width: 14px; height: 10px; border-radius: 2px; }
		.vtnt-vt { background: rgba(255,185,0,0.45); border: 1px solid rgba(200,145,0,0.5); }
		.vtnt-nt { background: rgba(74,144,217,0.45); border: 1px solid rgba(50,110,180,0.5); }

		/* Mobile: only the canvas area scrolls — the header stays at viewport width */
		@media (max-width: 640px) {
			.chart-canvas-outer { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
			.chart-scroll { min-width: 600px; height: 260px; }
		}
	</style>
	<script>
		// Wrap every canvas in a .chart-scroll div so Chart.js sizes to that
		// container. Runs before any chart is initialised (which happens in
		// fetch callbacks, always after DOMContentLoaded).
		document.addEventListener('DOMContentLoaded', function() {
			if (window.innerWidth >= 640) return;
			document.querySelectorAll('.chart-section canvas').forEach(function(canvas) {
				var outer = document.createElement('div');
				outer.className = 'chart-canvas-outer';
				var inner = document.createElement('div');
				inner.className = 'chart-scroll';
				canvas.parentNode.insertBefore(outer, canvas);
				outer.appendChild(inner);
				inner.appendChild(canvas);
			});
		});
	</script>
	<script>
		// buildTimeAxis builds the array of 15-min slot label strings and the list of
		// midnight boundary indices for a given month string ("YYYY-MM").
		// Returns { times, midnightIndices }.
		function buildTimeAxis(month) {
			var parts = month.split('-');
			var yr = Number(parts[0]), mo = Number(parts[1]);
			var times = [];
			var cursor = new Date(yr, mo - 1, 1, 0, 0);
			var end = new Date(yr, mo, 1, 0, 0);
			while (cursor < end) {
				var dd = String(cursor.getDate()).padStart(2, '0');
				var mm = String(cursor.getMonth() + 1).padStart(2, '0');
				var hh = String(cursor.getHours()).padStart(2, '0');
				var mi = String(cursor.getMinutes()).padStart(2, '0');
				times.push(dd + '.' + mm + '. ' + hh + ':' + mi);
				cursor = new Date(cursor.getTime() + 15 * 60000);
			}
			var midnightIndices = [];
			for (var ti = 0; ti < times.length; ti++) {
				if (times[ti].endsWith('00:00') && ti > 0) midnightIndices.push(ti);
			}
			return { times: times, midnightIndices: midnightIndices };
		}

		// buildCrosshairPlugin returns a Chart.js plugin instance that draws vertical
		// day-separator lines at midnight boundaries and a dashed hover crosshair.
		function buildCrosshairPlugin(midnightIndices, isDark) {
			return {
				id: 'crosshair',
				afterDraw: function(chart) {
					var xAxis = chart.scales.x;
					var yAxis = chart.scales.y;
					var ctx = chart.ctx;

					// Day separators
					ctx.save();
					ctx.lineWidth = 1;
					ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
					for (var i = 0; i < midnightIndices.length; i++) {
						var px = xAxis.getPixelForValue(midnightIndices[i]);
						if (px >= xAxis.left && px <= xAxis.right) {
							ctx.beginPath();
							ctx.moveTo(px, yAxis.top);
							ctx.lineTo(px, yAxis.bottom);
							ctx.stroke();
						}
					}
					ctx.restore();

					// Hover crosshair
					if (chart.tooltip && chart.tooltip.getActiveElements().length > 0) {
						var x = chart.tooltip.getActiveElements()[0].element.x;
						ctx.save();
						ctx.beginPath();
						ctx.moveTo(x, yAxis.top);
						ctx.lineTo(x, yAxis.bottom);
						ctx.lineWidth = 1;
						ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.3)';
						ctx.setLineDash([4, 4]);
						ctx.stroke();
						ctx.restore();
					}
				}
			};
		}

		// kwhLabel formats a Chart.js tooltip label with 4 decimal places and a
		// comma as the decimal separator (Croatian locale convention).
		function kwhLabel(ctx) {
			return ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(4).replace('.', ',') + ' kWh';
		}

		// exportXlsx creates and downloads an XLSX file.
		// rows: array of arrays where the first row is the header.
		function exportXlsx(filename, rows) {
			var wb = XLSX.utils.book_new();
			var ws = XLSX.utils.aoa_to_sheet(rows);
			XLSX.utils.book_append_sheet(wb, ws, 'Podaci');
			XLSX.writeFile(wb, filename);
		}

		// downloadPng screenshots a canvas element and triggers a PNG download.
		// A white background is composited behind the chart so the export is
		// not transparent when opened outside of the browser.
		function downloadPng(canvasEl, filename) {
			var tmp = document.createElement('canvas');
			tmp.width = canvasEl.width;
			tmp.height = canvasEl.height;
			var ctx = tmp.getContext('2d');
			ctx.fillStyle = '#ffffff';
			ctx.fillRect(0, 0, tmp.width, tmp.height);
			ctx.drawImage(canvasEl, 0, 0);
			var a = document.createElement('a');
			a.download = filename;
			a.href = tmp.toDataURL('image/png');
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
		}

		// buildVTNTRangesFromTimes computes contiguous NT and VT index ranges from the
		// times array produced by buildTimeAxis. Returns { nt: [[start,end], ...], vt: [...] }
		// or null when tariffModel is not 'bijeli' / 'crveni'.
		// Times are assumed to be in Europe/Zagreb local time (format "DD.MM. HH:MM").
		function buildVTNTRangesFromTimes(times, month, tariffModel) {
			if (tariffModel !== 'bijeli' && tariffModel !== 'crveni') return null;

			var parts = month.split('-');
			var year = parseInt(parts[0], 10), mon = parseInt(parts[1], 10);

			// Cache DST determination per day number.
			var summerCache = {};
			function isSummer(day) {
				if (summerCache[day] !== undefined) return summerCache[day];
				var d = new Date(Date.UTC(year, mon - 1, day, 11, 0, 0));
				var fmt = new Intl.DateTimeFormat('en', { timeZone: 'Europe/Zagreb', timeZoneName: 'shortOffset' });
				var fmtParts = fmt.formatToParts(d);
				var tz = fmtParts.find(function(p) { return p.type === 'timeZoneName'; });
				var result = false;
				if (tz) { var m = tz.value.match(/GMT\+(\d+)/); result = m ? parseInt(m[1], 10) === 2 : false; }
				return (summerCache[day] = result);
			}

			var ntRanges = [], vtRanges = [];
			var curType = null, curStart = 0;

			for (var i = 0; i < times.length; i++) {
				var t = times[i];
				var day  = parseInt(t.substring(0, 2), 10);
				var hour = parseInt(t.substring(7, 9), 10);
				var summer = isSummer(day);
				var isVT = summer ? (hour >= 8 && hour < 22) : (hour >= 7 && hour < 21);
				var type = isVT ? 'vt' : 'nt';
				if (type !== curType) {
					if (curType !== null) {
						(curType === 'nt' ? ntRanges : vtRanges).push([curStart, i]);
					}
					curType = type;
					curStart = i;
				}
			}
			if (curType !== null) {
				(curType === 'nt' ? ntRanges : vtRanges).push([curStart, times.length]);
			}
			return { nt: ntRanges, vt: vtRanges };
		}

		// buildVTNTPlugin returns a Chart.js local plugin that shades VT (amber) and
		// NT (blue) periods in the chart background. Pass null vtntRanges to get null back.
		function buildVTNTPlugin(vtntRanges, isDark) {
			if (!vtntRanges) return null;
			var ntColor = isDark ? 'rgba(74,144,217,0.13)' : 'rgba(74,144,217,0.10)';
			var vtColor = isDark ? 'rgba(255,185,0,0.09)'  : 'rgba(255,185,0,0.07)';
			return {
				id: 'vtntBackground',
				beforeDatasetsDraw: function(chart) {
					var ctx = chart.ctx;
					var xAxis = chart.scales.x, yAxis = chart.scales.y;
					if (!xAxis || !yAxis) return;
					var top = yAxis.top, bottom = yAxis.bottom;
					ctx.save();
					function drawRanges(ranges, color) {
						ctx.fillStyle = color;
						ranges.forEach(function(r) {
							var x1 = xAxis.getPixelForValue(r[0]);
							var x2 = r[1] < chart.data.labels.length
								? xAxis.getPixelForValue(r[1])
								: xAxis.right;
							x1 = Math.max(x1, xAxis.left);
							x2 = Math.min(x2, xAxis.right);
							if (x2 > x1) ctx.fillRect(x1, top, x2 - x1, bottom - top);
						});
					}
					drawRanges(vtntRanges.nt, ntColor);
					drawRanges(vtntRanges.vt, vtColor);
					ctx.restore();
				}
			};
		}

		// svgElementToCanvas converts an SVG DOM element to an HTMLCanvasElement
		// and calls callback(canvas) when done. Used for the calendar heatmap.
		function svgElementToCanvas(svgEl, callback) {
			var w = Number(svgEl.getAttribute('width')) || 800;
			var h = Number(svgEl.getAttribute('height')) || 200;
			var svgData = new XMLSerializer().serializeToString(svgEl);
			var blob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
			var url = URL.createObjectURL(blob);
			var img = new Image();
			img.onload = function() {
				var canvas = document.createElement('canvas');
				canvas.width = w;
				canvas.height = h;
				var ctx = canvas.getContext('2d');
				ctx.fillStyle = '#ffffff';
				ctx.fillRect(0, 0, w, h);
				ctx.drawImage(img, 0, 0);
				URL.revokeObjectURL(url);
				callback(canvas);
			};
			img.src = url;
		}
	</script>
}
