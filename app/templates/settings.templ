package templates

// Tariff model constants matching the tariff_model_enum values in PostgreSQL.
const (
	TariffModelPlavi  = "plavi"
	TariffModelBijeli = "bijeli"
	TariffModelCrveni = "crveni"
)

// SettingsMeteringPoint holds the display data for a single metering point row
// in the settings page tariff selection section.
type SettingsMeteringPoint struct {
	Code        string
	Address     string
	TariffModel string // see TariffModel* constants
}

// SettingsProps holds all data passed to the Settings template.
type SettingsProps struct {
	// HepUsername is the configured HEP_USERNAME, shown read-only — credentials
	// live in the environment, not in the database.
	HepUsername string
	// HepConfigured reports whether both HEP_USERNAME and HEP_PASSWORD are set.
	HepConfigured  bool
	MeteringPoints []SettingsMeteringPoint
	SuccessMsg     string
	ErrorMsg       string
}

templ Settings(p SettingsProps) {
	@Layout(LayoutProps{Title: "Postavke", ActivePath: "/postavke"}) {
		<style>
			.settings-page { max-width: 960px; margin: 0 auto; }
			.settings-page h1 { margin-bottom: 1.5rem; }
			.settings-alerts { margin-bottom: 1.5rem; }
			.settings-section h2 { margin-bottom: 1.25rem; }
			.settings-section + .settings-section { margin-top: 1.5rem; }
			.hep-test-btn { font-size: 1rem; padding: 0.75rem 1.5rem; background: #f0f4ff; border: 1px solid #c7d4f0; color: #2563eb; border-radius: 4px; cursor: pointer; }
			.hep-test-btn:hover { background: #e0eaff; }
			.hep-test-btn:disabled { opacity: 0.6; cursor: default; }
			html.dark .hep-test-btn { background: #0f3460; border-color: #1e3a5f; color: #7eb8f7; }
			html.dark .hep-test-btn:hover { background: #1a4a80; }
			.hep-test-result { display: block; font-size: 0.82rem; margin-top: 0.5rem; min-height: 0; }
			.hep-test-result.ok { color: #27ae60; }
			.hep-test-result.err { color: #c0392b; }
			html.dark .hep-test-result.ok { color: #4cbb7f; }
			html.dark .hep-test-result.err { color: #e57373; }

			/* Read-only credential summary */
			.hep-info { font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem; }
			.hep-info dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: #888; }
			.hep-info dd { margin: 0 0 0.75rem; font-family: monospace; }
			html.dark .hep-info dt { color: #6a8aaa; }

			/* Metering points tariff */
			.mp-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
			.mp-table th { text-align: left; font-size: 0.8rem; font-weight: 600; color: #888; text-transform: uppercase; letter-spacing: 0.04em; padding: 0 0 0.5rem; border-bottom: 1px solid #e5e7eb; }
			.mp-table td { padding: 0.6rem 0; border-bottom: 1px solid #f0f2f5; vertical-align: middle; }
			.mp-table tr:last-child td { border-bottom: none; }
			.mp-table .mp-code { font-size: 0.8rem; color: #888; font-family: monospace; }
			.mp-table .mp-address { font-size: 0.9rem; }
			.mp-table select { font-size: 0.875rem; padding: 0.3rem 0.5rem; border-radius: 4px; border: 1px solid #d1d5db; background: #fff; }
			.mp-table .mp-save { font-size: 0.8rem; padding: 0.3rem 0.75rem; }
			html.dark .mp-table th { color: #6a8aaa; border-bottom-color: #1e3a5f; }
			html.dark .mp-table td { border-bottom-color: #162030; }
			html.dark .mp-table .mp-code { color: #6a8aaa; }
			html.dark .mp-table select { background: #0f3460; border-color: #1e3a5f; color: #e0e0e0; }
			.mp-hint { font-size: 0.8rem; color: #777; margin-top: 0.35rem; line-height: 1.4; }
			html.dark .mp-hint { color: #6a8aaa; }
		</style>
		<div class="settings-page">
			<h1>Postavke</h1>
			if p.SuccessMsg != "" || p.ErrorMsg != "" {
				<div class="settings-alerts">
					if p.SuccessMsg != "" {
						<div class="alert alert-success">{ p.SuccessMsg }</div>
					}
					if p.ErrorMsg != "" {
						<div class="alert alert-error">{ p.ErrorMsg }</div>
					}
				</div>
			}
			<section class="settings-section">
				<h2>HEP pristupni podaci</h2>
				if p.HepConfigured {
					<dl class="hep-info">
						<dt>Korisničko ime</dt>
						<dd>{ p.HepUsername }</dd>
						<dt>Lozinka</dt>
						<dd>••••••••</dd>
					</dl>
					<p class="mp-hint" style="margin-bottom:1.25rem">
						Pristupni podaci čitaju se iz <code>config.ini</code> datoteke
						(<code>HEP_USERNAME</code> i <code>HEP_PASSWORD</code>). Nakon promjene
						ponovo pokrenite aplikaciju.
					</p>
				} else {
					<div class="alert alert-warn" style="margin-bottom:1.25rem; font-size:0.875rem">
						&#x26A0;&#xFE0F; HEP pristupni podaci nisu postavljeni. Upišite
						<code>HEP_USERNAME</code> i <code>HEP_PASSWORD</code> u <code>config.ini</code>
						datoteku i ponovo pokrenite aplikaciju.
					</div>
				}
				if p.HepConfigured {
					<button type="button" class="hep-test-btn" id="hep-test-btn">Testiraj vezu</button>
					<span class="hep-test-result" id="hep-test-result"></span>
				}
			</section>
			if len(p.MeteringPoints) > 0 {
				<section class="settings-section">
					<h2>Mjerna mjesta</h2>
					<table class="mp-table">
						<thead>
							<tr>
								<th>Adresa</th>
								<th style="width:40%">Tarifni model</th>
							</tr>
						</thead>
						<tbody>
							for _, mp := range p.MeteringPoints {
								<tr>
									<td>
										<div class="mp-address">{ mp.Address }</div>
										<div class="mp-code">{ mp.Code }</div>
									</td>
									<td>
										<form method="POST" action={ templ.SafeURL("/postavke/mjerno-mjesto/" + mp.Code + "/tarifa") } style="display:flex;gap:0.5rem;align-items:center">
											<div>
												<select name="tariff_model" onchange="mpHint(this)">
													<option value={ TariffModelPlavi } if mp.TariffModel == TariffModelPlavi { selected }>Plavi</option>
													<option value={ TariffModelBijeli } if mp.TariffModel == TariffModelBijeli { selected }>Bijeli</option>
													<option value={ TariffModelCrveni } if mp.TariffModel == TariffModelCrveni { selected }>Crveni</option>
												</select>
												<div class="mp-hint"></div>
											</div>
											<button type="submit" class="mp-save" style="align-self:flex-start">Spremi</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</section>
			}
		</div>
		<script>
			(function() {
				var btn = document.getElementById('hep-test-btn');
				if (!btn) return;
				btn.addEventListener('click', function() {
					var result = document.getElementById('hep-test-result');
					result.className = 'hep-test-result';
					result.textContent = '';
					btn.disabled = true;
					btn.textContent = 'Testiranje…';
					fetch('/api/hep-test', { method: 'POST' })
						.then(function(r) { return r.json(); })
						.then(function(d) {
							if (d.ok) {
								result.className = 'hep-test-result ok';
								result.textContent = 'Veza uspješna.';
							} else {
								result.className = 'hep-test-result err';
								result.textContent = 'Greška: ' + (d.error || 'nepoznata greška');
							}
						})
						.catch(function() {
							result.className = 'hep-test-result err';
							result.textContent = 'Mrežna greška.';
						})
						.finally(function() {
							btn.disabled = false;
							btn.textContent = 'Testiraj vezu';
						});
				});
			})();

			var mpHints = {
				'plavi':  'Jedinstvena dnevna tarifa — ista cijena kWh cijeli dan. Dostupan korisnicima s jednotarifnim ili višetarifnim brojilom.',
				'bijeli': 'Viša (VT) i niža (NT) dnevna tarifa. Zimi: VT 07–21 h, NT 21–07 h. Ljeti: VT 08–22 h, NT 22–08 h. Zahtijeva višetarifno brojilo.',
				'crveni': 'Kao Bijeli, uz obračun obračunske vršne radne snage (€/kW). Za priključnu snagu veću od 22 kW.'
			};

			function mpHint(select) {
				var hint = select.parentElement.querySelector('.mp-hint');
				hint.textContent = mpHints[select.value] ?? '';
			}

			document.querySelectorAll('.mp-table select').forEach(function(sel) { mpHint(sel); });
		</script>
	}
}
